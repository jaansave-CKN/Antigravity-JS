# pre-commit — bloquea commitear archivos .env / claves_privadas.txt y patrones
# de secretos conocidos. Instalado tras el incidente de .env commiteado en
# mayo 2026 (repo público) — nunca debe volver a pasar. Versionado con Husky
# para que proteja cualquier clon nuevo del repo, no solo esta máquina.

# ── React Doctor — escaneo de diagnósticos en lo staged (no bloqueante) ──────
# FIX (2026-09-05, "node: not found" reproducido en vivo): este bloque vivía
# en `.husky/_/pre-commit` — un archivo GENERADO por Husky (`.husky/_/.gitignore`
# tiene "*"), que se regenera y pierde cualquier edición manual en el próximo
# `npm install`. Se movió aquí, al archivo versionado que Husky sí ejecuta
# siempre (`.husky/_/h` resuelve `.husky/pre-commit` y lo corre vía `sh`), para
# que el fix sobreviva a un clon nuevo o una reinstalación. El `sh` no-login
# que git usa para hooks en este entorno (Windows + Git Bash) no hereda el
# PATH interactivo del usuario — ni `command -v node` ni el `exec node` interno
# del shim `.bin/react-doctor` lo encontraban, aunque Node esté instalado.
# Mismo hallazgo ya resuelto más abajo para el gate de arquitectura
# (2026-08-08) — se resuelve la ruta real una sola vez y se antepone al PATH
# de este script, para que las estrategias internas del hook (shim, react-doctor
# global, pnpm dlx, npx) lo encuentren sin cambiar su propia lógica.
NODE_BIN="$(command -v node 2>/dev/null || true)"
if [ -z "$NODE_BIN" ] && [ -x "/c/Program Files/nodejs/node.exe" ]; then
  NODE_BIN="/c/Program Files/nodejs/node.exe"
fi
if [ -n "$NODE_BIN" ]; then
  PATH="$(dirname "$NODE_BIN"):$PATH"
  export PATH
fi

react_doctor_scan_staged_files() {
  if [ -x "./node_modules/.bin/react-doctor" ]; then
    "./node_modules/.bin/react-doctor" --staged --blocking warning
    return
  fi

  if command -v react-doctor >/dev/null 2>&1; then
    react-doctor --staged --blocking warning
    return
  fi

  if command -v pnpm >/dev/null 2>&1; then
    pnpm dlx react-doctor@latest --staged --blocking warning
    return
  fi

  if command -v npx >/dev/null 2>&1; then
    npx --yes react-doctor@latest --staged --blocking warning
    return
  fi

  printf '%s\n' "react-doctor: command not found; skipping staged scan."
}

react_doctor_output=$(mktemp "${TMPDIR:-/tmp}/react-doctor-hook.XXXXXX")
if react_doctor_scan_staged_files > "$react_doctor_output" 2>&1; then
  rm -f "$react_doctor_output"
else
  cat "$react_doctor_output" >&2
  rm -f "$react_doctor_output"
  printf '%s\n' "React Doctor found staged regressions." "Run react-doctor --staged --blocking warning to inspect." "Want them fixed? Ask your agent to run that command and resolve the findings." >&2
fi
# ── Fin React Doctor ──────────────────────────────────────────────────────────

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# .env.example es la plantilla pública (solo placeholders vacíos, sin secretos
# reales) y SÍ debe commitearse — falso positivo detectado 2026-08-08 al
# bloquear una edición legítima. Se excluye explícitamente antes del check.
CANDIDATOS=$(echo "$STAGED" | grep -Ev '(^|/)\.env\.example$' || true)

BLOCKED_FILES=$(echo "$CANDIDATOS" | grep -E '(^|/)(\.env(\..*)?|claves_privadas\.txt|\.mcp\.json)$' || true)
if [ -n "$BLOCKED_FILES" ]; then
  echo "❌ COMMIT BLOQUEADO — archivo de secretos detectado en el stage:"
  echo "$BLOCKED_FILES"
  echo ""
  echo "Estos archivos NUNCA deben commitearse. Si es un falso positivo,"
  echo "usa 'git commit --no-verify' (solo si estás 100% seguro)."
  exit 1
fi

# Patrones de secretos conocidos (prefijos reales de proveedores) en el diff staged
SECRET_PATTERN='github_pat_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{20,}|xkeysib-[A-Za-z0-9]{20,}|sb_secret_[A-Za-z0-9_]{20,}|rnd_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|AQ\.Ab8R[A-Za-z0-9_-]{20,}'

MATCH=$(git diff --cached -U0 | grep -E "^\+" | grep -Ev "^\+\+\+" | grep -E "$SECRET_PATTERN" || true)
if [ -n "$MATCH" ]; then
  echo "❌ COMMIT BLOQUEADO — patrón de API key real detectado en el diff:"
  echo "$MATCH" | sed -E 's/(github_pat_|ghp_|xkeysib-|sb_secret_|rnd_|sk-|AQ\.Ab8R)[A-Za-z0-9_-]{6}/\1******/g'
  echo ""
  echo "Si es un falso positivo, usa 'git commit --no-verify' (solo si estás 100% seguro)."
  exit 1
fi

# Gate de arquitectura — "cero código sin diseño aprobado" (docs/ARQUITECTURA_AGENTICA_ANTIGRAVITY.md §5.2).
# Degradación segura: sin ANTHROPIC_API_KEY configurada, informa y NO bloquea
# (ver scripts/architecture-gate.cjs) — mismo patrón standby que Stripe/Wompi/Sentry.
# Resolución de `node` a prueba de PATH: en algunos shells de Windows/Git Bash
# "node" no está en PATH pese a estar instalado (hallazgo real 2026-08-08,
# reproducido en vivo) — un "command not found" aquí NO debe bloquear el
# commit, es un problema de entorno, no un veredicto de arquitectura real.
NODE_BIN="$(command -v node 2>/dev/null || true)"
if [ -z "$NODE_BIN" ] && [ -x "/c/Program Files/nodejs/node.exe" ]; then
  NODE_BIN="/c/Program Files/nodejs/node.exe"
fi
if [ -z "$NODE_BIN" ]; then
  echo "ℹ️  [GATE_ARQUITECTURA] No se encontró 'node' en este shell — se omite el gate (no bloquea)."
  exit 0
fi
"$NODE_BIN" scripts/architecture-gate.cjs --check-gate
exit $?
