rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones helper ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEnabled() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      // Solo admins crean/borran usuarios
      allow create, delete: if isAdmin();
      // El propio usuario puede actualizar su perfil, pero NO role/disabled/proyectos
      allow update: if (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'disabled', 'proyectos']))
        || isAdmin();
    }

    // ── Proyectos ─────────────────────────────────────────────────────────────
    match /proyectos/{proyectoId} {
      allow read: if isEnabled() &&
        (isOwner(resource.data.ownerUid) ||
          request.auth.uid in resource.data.members);

      allow create: if isEnabled() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isEnabled() &&
        (isOwner(resource.data.ownerUid) ||
          request.auth.uid in resource.data.admins);

      allow delete: if isEnabled() && isOwner(resource.data.ownerUid);

      // ── Favoritos por proyecto ────────────────────────────────────────────
      match /favoritos/{convId} {
        allow read, write: if isEnabled() &&
          (isOwner(get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.ownerUid) ||
            request.auth.uid in get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.members);
      }

      // ── Alertas por proyecto ──────────────────────────────────────────────
      match /alertas/{alertaId} {
        allow read: if isEnabled() &&
          (isOwner(get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.ownerUid) ||
            request.auth.uid in get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.members);
        allow write: if false;
      }

      // ── Config por proyecto ───────────────────────────────────────────────
      match /config/{configId} {
        allow read, write: if isEnabled() &&
          (isOwner(get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.ownerUid) ||
            request.auth.uid in get(/databases/$(database)/documents/proyectos/$(proyectoId)).data.admins);
      }
    }

    // ── Radar (lectura activos, escritura solo Admin SDK) ─────────────────────
    match /radar/{convId} {
      allow read: if isEnabled();
      allow write: if false;
    }

    // ── Auditoría (solo admins, inmutable) ────────────────────────────────────
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Catch-all: denegar todo lo demás ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
