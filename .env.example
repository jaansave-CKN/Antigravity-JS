# .env.example — plantilla de variables de entorno, SIN valores reales.
# Copia este archivo a .env y rellena cada valor. Generado 2026-08-12 a
# partir de las variables reales que este proyecto usa hoy (nombres, no
# valores — nunca commitear .env real, el chequeo de secretos de
# 006_DEVSECOPS_INFRAESTRUCTURA lo bloquea si intentas).

# --- Servidor ---
PORT=
NODE_ENV=
ALLOWED_ORIGINS=
VITE_API_URL=

# --- IA / Anthropic (motor único, ver AGENTS.md) ---
ANTHROPIC_API_KEY=
PRIMARY_AI_MODEL=
TAVILY_API_KEY=

# --- Standby, sin consumidor activo en backend hoy (ver docs/ARQUITECTURA_AGENTICA_ANTIGRAVITY.md §7.1) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Supabase / PostgreSQL ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# --- Cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ---
JWT_SECRET=
FIREBASE_CONFIG_PATH=

# --- Notificaciones / email ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=

# --- Integraciones ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
RENDER_API_KEY=
STITCH_API_KEY=
MCP_API_KEY=
INNGEST_EVENT_KEY=
