# ============================================================
#  RadarFondos 360 — Template de Variables de Entorno
#  Copiar a .env y rellenar los valores reales
# ============================================================

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
PORT=3000

# ── JWT — OBLIGATORIO ─────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# Vacío → SQLite local (radar.db). Solo para desarrollo.
# Con URL → PostgreSQL (Neon, Supabase, Railway). Requerido en producción.
# Obtener URL en: neon.tech → Dashboard → Connection string
DATABASE_URL=

# ── CIFRADO DE API KEYS ───────────────────────────────────────────────────────
# Opcional. Si se omite, usa JWT_SECRET como fallback.
ENCRYPTION_KEY=

# ── FRONTEND ──────────────────────────────────────────────────────────────────
# Dev local:       http://localhost:5173
# Producción:      https://TU-APP.web.app (Firebase Hosting URL)
FRONTEND_URL=http://localhost:5173

# URL del backend (usada por Vite proxy en dev y por el frontend en producción)
# Dev local:       http://localhost:3000
# Producción:      https://TU-SERVICIO.onrender.com
VITE_API_URL=http://localhost:3000

# ── EMAIL TRANSACCIONAL — BREVO ───────────────────────────────────────────────
# Registrarse gratis en brevo.com → SMTP & API → API Keys
# Sin esto: el reset de contraseña no envía emails (responde 200 igualmente)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RadarFondos 360

# ── GOOGLE GEMINI API — OPCIONAL ──────────────────────────────────────────────
# Desbloquea: árbol de objetivos IA + match scoring semántico en el Formulador
# Obtener gratuitamente en: aistudio.google.com → Get API key
GOOGLE_API_KEY=

# ── GOOGLE OAUTH2 — OPCIONAL ──────────────────────────────────────────────────
# Para el botón "Iniciar sesión con Google"
# Crear en: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev local:    http://localhost:3000/api/auth/google/callback
# Producción:   https://TU-SERVICIO.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── GITHUB ACTIONS SECRETS REQUERIDOS ────────────────────────────────────────
# Configurar en: github.com → Repo → Settings → Secrets → Actions
#
#   VITE_API_URL        → URL del backend Render (https://TU-SERVICIO.onrender.com)
#   VITE_GEMINI_API_KEY → (opcional) Google Gemini API key para features IA
#   FIREBASE_TOKEN      → Token Firebase CLI (firebase login:ci)
#   AWS_ACCESS_KEY_ID   → (opcional) Para backup S3
#   AWS_SECRET_ACCESS_KEY
#   AWS_S3_BUCKET
