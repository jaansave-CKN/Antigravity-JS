# .env.example — plantilla de variables de entorno, SIN valores reales.
# Copia este archivo a .env y rellena cada valor. Generado 2026-08-12 a
# partir de las variables reales que este proyecto usa hoy (nombres, no
# valores — nunca commitear .env real, el chequeo de secretos de
# 006_DEVSECOPS_INFRAESTRUCTURA lo bloquea si intentas).

# --- Servidor ---
PORT=
NODE_ENV=
ALLOWED_ORIGINS=
VITE_API_URL=

# --- IA (ADR-0004): Claude es el primario obligatorio y Gemini el único respaldo, para la app
# (LlmGateway), el gate 002/subgates y el auditor 008 en CI. Basta una de las dos keys; sin
# ninguna, la IA de la app queda "no configurada" y el gate bloquea (Axioma II.1).
# Gemini: GEMINI_API_KEY o, si no está, GOOGLE_API_KEY. Debe ser de un proyecto con
# facturación activa (en el nivel gratuito Google puede usar el contenido — Ley 1581).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Supabase / PostgreSQL ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# --- Cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cola de cuarentena (DLQ) de RadFor-360: archivo JSONL append-only. Vacío = logs/dlq/cuarentena.jsonl
# (logs/ no se versiona). Con UPSTASH_* configurado, además RPUSH durable a la lista dlq:cuarentena.
DLQ_PATH=

# --- Auth ---
JWT_SECRET=

# --- Firebase Admin (2026-08-12: reemplaza FIREBASE_CONFIG_PATH/serviceAccountKey.json
# como via primaria -- Render no soporta bien "Secret Files" segun el equipo. El
# archivo local sigue funcionando como fallback de desarrollo si prefieres no usar
# estas 3 variables localmente, ver src/shared/infrastructure/FirebaseAdmin.js) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM de una sola linea -- reemplaza saltos de linea reales por "\n" literal
# (2 caracteres), el codigo los des-escapa en tiempo de ejecucion.
FIREBASE_PRIVATE_KEY=

# --- Monitoreo de errores (Sentry, 2026-08-13 -- ver src/shared/infrastructure/SentryMonitoring.js) ---
# Sin este valor, el servidor arranca igual pero sin captura de errores
# (advertencia visible en el log de arranque, no falla el arranque).
SENTRY_DSN=

# --- FinOps / costo y tokens por request de IA (Langfuse, 2026-09-04 -- ver
# src/shared/infrastructure/LangfuseMonitoring.js). Sin estas 2 variables el
# servidor arranca igual, sin tracking de costo (advertencia en el log de
# arranque, no falla el arranque). LANGFUSE_HOST solo si usas self-host;
# vacío = Langfuse Cloud. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Notificaciones / email ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=

# --- Integraciones ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
RENDER_API_KEY=
STITCH_API_KEY=
MCP_API_KEY=
INNGEST_EVENT_KEY=

# Gate de arquitectura: el soft-fail (API de IA sin saldo/429/5xx) ya NO se habilita desde .env
# (GATE_SOFT_FAIL y GATE_SOFT_FAIL_AUTORIZADO_POR retiradas, ADR-0004 §6). Solo el dueno, por commit:
#   node agents/architecture-gate.cjs --aprobar-diseno --permitir-soft-fail --autorizado-por "nombre"
# y el commit queda pendiente de: node agents/architecture-gate.cjs --reevaluar-commit <sha>

# Modelos (ADR-0004 §2.3): se descubren solos en el catálogo de cada proveedor y se eligen por gama
# y recencia (razonamiento: Opus → Sonnet → Gemini Pro → Flash; rapido: Sonnet → Haiku → Gemini
# Flash → Flash-Lite). Una versión nueva de claude-* o gemini-* entra sin tocar código.
# Fijación opcional del catálogo (ids separados por coma, en orden; vacío = descubrimiento):
LLM_MODELOS_CLAUDE=
LLM_MODELOS_GEMINI=
# Vigencia de la caché del descubrimiento en horas (1-168; default 24)
LLM_DESCUBRIMIENTO_TTL_H=
# Plazo de primer byte de cada eslabón antes de conmutar (ms, 5000-120000; default 15000)
GATE_FAILOVER_PRIMER_BYTE_MS=
# FinOps: caracteres por token para estimar uso cuando el proveedor no lo reporta (1.5-6; default 3.1)
# y TRM COP/USD para el costo (default 3273.49, TRM 2026-10-03). Tarifas por gama en USD por millón
# de tokens; LLM_TARIFAS_USD las reemplaza: {"<id o gama>": {"entrada": n, "salida": n}}
LLM_CARACTERES_POR_TOKEN=
TRM_COP_USD=
LLM_TARIFAS_USD=
# Breakers y caché del descubrimiento de la app (por defecto logs/llm/)
LLM_BREAKER_DIR=
