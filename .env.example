# =============================================================================
# RadarFondos 360 — Variables de Entorno para Despliegue Cloud
# Copiar como .env y completar con valores reales antes de desplegar.
# NUNCA commitear el .env al repositorio (está en .gitignore).
# =============================================================================

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
# Render/Railway asignan PORT automáticamente vía variable de entorno.
# El servidor Express escucha process.env.PORT || 8000.
PORT=8000

# ── BASE DE DATOS (PostgreSQL obligatorio en producción) ──────────────────────
# Obtener en: neon.tech / supabase.com / railway.app → Connection string
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ── AUTENTICACIÓN JWT ─────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres en producción.
JWT_SECRET=

# ── SUPABASE AUTH (alternativa enterprise al JWT local) ───────────────────────
#
# SWITCH TRANSPARENTE: el sistema detecta automáticamente qué modo usar.
#
#   SIN estas variables → modo JWT LOCAL (desarrollo, sin Supabase)
#     auth.middleware.js usa jwt.verify(token, JWT_SECRET)
#     El servidor de login/register de Express sigue activo.
#
#   CON estas variables → modo SUPABASE AUTH (producción)
#     auth.middleware.js usa supabase.auth.getUser(token)
#     Los tokens emitidos por el cliente Supabase son reconocidos en el backend.
#     NO se requiere refactorizar ningún código — solo añadir los valores abajo.
#
# Obtener en: supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY: solo para jobs en background (Inngest persist-bilingual).
# Nunca exponer en el cliente frontend. Obtener en: Project Settings → API → service_role
SUPABASE_SERVICE_KEY=

# ── FRONTEND URL (para links en emails y redirects OAuth) ─────────────────────
# Producción:  https://tu-app.onrender.com  o  https://tu-app.vercel.app
# Desarrollo:  http://localhost:5173
FRONTEND_URL=

# ── VITE: URL del backend (usada en el cliente React) ─────────────────────────
# En producción: igual a FRONTEND_URL si frontend y backend están en el mismo dominio,
# o la URL del backend Render si son dominios distintos.
# Desarrollo: http://localhost:8000
VITE_API_URL=

# ── STRIPE (pagos y suscripciones) ───────────────────────────────────────────
# Obtener en: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Obtener en: Stripe Dashboard → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Crear en: Stripe Dashboard → Products → Prices (un ID por plan)
STRIPE_PRICE_RADAR=
STRIPE_PRICE_FORMULADOR=
STRIPE_PRICE_SUITE=

# ── RESEND (emails transaccionales — reemplaza Brevo) ─────────────────────────
# Obtener en: resend.com → API Keys
RESEND_API_KEY=
# Formato: "RadarFondos 360 <noreply@tudominio.co>"
# El dominio debe estar verificado en el panel de Resend.
EMAIL_FROM=

# ── INNGEST (background jobs — formulación asíncrona con IA) ─────────────────
# Obtener en: inngest.com → Event Keys y Signing Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── SENTRY (observabilidad — colector remoto de errores del frontend) ────────
# Opcional. Sin DSN, captureError() es no-op (solo console + localStorage).
# Obtener en: sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# ── GOOGLE AI (Gemini — árbol de objetivos + embeddings + traducción EN) ───────
# Obtener en: aistudio.google.com → Get API key
GOOGLE_API_KEY=

# ── GOOGLE OAUTH2 (Login con Google — opcional) ───────────────────────────────
# Crear en: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Producción: https://tu-backend.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── CIFRADO DE CLAVES DE USUARIO ──────────────────────────────────────────────
# Opcional. Si se omite usa JWT_SECRET como fallback.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── LEGACY BREVO (reemplazado por Resend — mantener para compatibilidad) ───────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RadarFondos 360

# =============================================================================
# VARIABLES QUE SE CONFIGURAN EN LA PLATAFORMA DE DESPLIEGUE (NO localmente)
# =============================================================================
#
# Render.com:
#   Dashboard → Service → Environment → Add Environment Variable
#
# Railway.app:
#   Project → Variables → New Variable
#
# Vercel (si se usa para el frontend):
#   Project → Settings → Environment Variables
#
# =============================================================================
# ORDEN DE EJECUCIÓN DE MIGRACIONES EN SUPABASE/NEON (una sola vez):
# =============================================================================
#   psql $DATABASE_URL -f backend/migrations/001_postgres_schema.sql
#   psql $DATABASE_URL -f backend/migrations/002_multitenant_saas.sql
#   psql $DATABASE_URL -f backend/migrations/003_schema_english_canonical.sql
#   psql $DATABASE_URL -f src/modules/formulador/migrations/001_formulador.sql
# =============================================================================
