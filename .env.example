# .env.example — plantilla de variables de entorno, SIN valores reales.
# Copia este archivo a .env y rellena cada valor. Generado 2026-08-12 a
# partir de las variables reales que este proyecto usa hoy (nombres, no
# valores — nunca commitear .env real, el chequeo de secretos de
# 006_DEVSECOPS_INFRAESTRUCTURA lo bloquea si intentas).

# --- Servidor ---
PORT=
NODE_ENV=
ALLOWED_ORIGINS=
VITE_API_URL=

# --- IA / Anthropic (motor único, ver AGENTS.md) ---
ANTHROPIC_API_KEY=
PRIMARY_AI_MODEL=
TAVILY_API_KEY=

# --- Standby, sin consumidor activo en backend hoy (ver docs/ARQUITECTURA_AGENTICA_ANTIGRAVITY.md §7.1) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Supabase / PostgreSQL ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# --- Cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cola de cuarentena (DLQ) de RadFor-360: archivo JSONL append-only. Vacío = logs/dlq/cuarentena.jsonl
# (logs/ no se versiona). Con UPSTASH_* configurado, además RPUSH durable a la lista dlq:cuarentena.
DLQ_PATH=

# --- Auth ---
JWT_SECRET=

# --- Firebase Admin (2026-08-12: reemplaza FIREBASE_CONFIG_PATH/serviceAccountKey.json
# como via primaria -- Render no soporta bien "Secret Files" segun el equipo. El
# archivo local sigue funcionando como fallback de desarrollo si prefieres no usar
# estas 3 variables localmente, ver src/shared/infrastructure/FirebaseAdmin.js) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM de una sola linea -- reemplaza saltos de linea reales por "\n" literal
# (2 caracteres), el codigo los des-escapa en tiempo de ejecucion.
FIREBASE_PRIVATE_KEY=

# --- Monitoreo de errores (Sentry, 2026-08-13 -- ver src/shared/infrastructure/SentryMonitoring.js) ---
# Sin este valor, el servidor arranca igual pero sin captura de errores
# (advertencia visible en el log de arranque, no falla el arranque).
SENTRY_DSN=

# --- FinOps / costo y tokens por request de IA (Langfuse, 2026-09-04 -- ver
# src/shared/infrastructure/LangfuseMonitoring.js). Sin estas 2 variables el
# servidor arranca igual, sin tracking de costo (advertencia en el log de
# arranque, no falla el arranque). LANGFUSE_HOST solo si usas self-host;
# vacío = Langfuse Cloud. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Notificaciones / email ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=

# --- Integraciones ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
RENDER_API_KEY=
STITCH_API_KEY=
MCP_API_KEY=
INNGEST_EVENT_KEY=

# Gate de arquitectura: soft-fail si la API de Anthropic no esta disponible (sin saldo/429/5xx). Ver AGENTS.md Axioma II.1
GATE_SOFT_FAIL=false
GATE_SOFT_FAIL_AUTORIZADO_POR=

# Proveedor de IA del gate (ADR-0002): nim (default, NVIDIA NIM gratuito) | anthropic (solo explicito, sin cascada)
GATE_PROVIDER=
NVIDIA_API_KEY=
GATE_MODEL=
# Solo si se sobreescribe; cualquier valor distinto de https://integrate.api.nvidia.com/v1 = bloqueo duro
GATE_NIM_BASE_URL=
# Cadena de conmutación entre modelos (enmienda ADR-0002 2026-10-04). Vacío = cadena NIM por
# defecto (gratuita, misma NVIDIA_API_KEY). Formato: nim:<org/modelo>,anthropic[:modelo]
# separados por coma, máx. 6; "none" = sin conmutación. Anthropic es DE PAGO: solo si se lista.
GATE_FALLBACK_CHAIN=
# Plazo de primer byte de cada eslabón antes de conmutar (ms, 5000-120000; default 15000)
GATE_FAILOVER_PRIMER_BYTE_MS=
# FinOps: caracteres por token para estimar uso cuando el proveedor no lo reporta (1.5-6; default 3.1,
# medido con deepseek-v4.1-flash) y TRM COP/USD para el costo (default 3273.49, TRM 2026-10-03).
LLM_CARACTERES_POR_TOKEN=
TRM_COP_USD=
# Aplicación (LlmGateway, ADR-0003 enmendado): orden de modelos NIM por tarea, ids separados
# por coma; vacío = perfil por defecto. Breakers de la app (por defecto logs/llm/).
LLM_PERFIL_RAPIDO=
LLM_PERFIL_RAZONAMIENTO=
LLM_BREAKER_DIR=
