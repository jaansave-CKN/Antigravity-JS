rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Traceability: Allow authorized user to view their activity logs
    match /audit_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.email == 'jaansave@gmail.com';
      allow write: if false; // Only Admin SDK (Backend) can write logs
    }

    // Donaciones - Autorizado para escritura Admin, lectura para usuario autenticado
    match /donaciones/{codigo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jaansave@gmail.com';
    }

    // Contadores para códigos de donación
    match /contadores/{docId} {
      allow read, write: if false; // Solo Admin SDK
    }

    // Proyectos Modulares
    match /proyectos_modulares/{proyectoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jaansave@gmail.com';
    }

    // Módulos de Proyecto
    match /modulos_proyecto/{moduloId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jaansave@gmail.com';
    }

    // Ubicaciones Geográficas
    match /ubicaciones_geograficas/{ubicacionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jaansave@gmail.com';
    }

    // Métricas de Proyecto
    match /metricas_proyecto/{proyectoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'jaansave@gmail.com';
    }

    // Default: Deny all other client-side access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
