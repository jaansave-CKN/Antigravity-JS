{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SoloSubirBackupsBajoElPrefijo",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::NOMBRE_DEL_BUCKET/backups/postgres/*",
        "arn:aws:s3:::NOMBRE_DEL_BUCKET/backups/sqlite/*"
      ]
    },
    {
      "Sid": "ExigirCifradoAES256EnCadaBackup",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::NOMBRE_DEL_BUCKET/backups/*",
      "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption": "AES256" } }
    },
    {
      "Sid": "SoloPorHTTPS",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::NOMBRE_DEL_BUCKET",
        "arn:aws:s3:::NOMBRE_DEL_BUCKET/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
