{
  "name": "brevo-total-integration",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.cjs",
    "test:gate": "node --test scripts/architecture-gate.test.cjs scripts/check_veto_008.test.cjs",
    "kill-port": "powershell -Command \"@(5000,5173) | ForEach-Object { $port=$_; Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue; Write-Host 'Puerto' $port 'liberado' } }\"",
    "fresh": "npm run kill-port && npm start",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server.js",
    "start": "concurrently \"npm run dev\" \"npm run api\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@getbrevo/brevo": "^2.0.0-beta.4",
    "@sentry/node": "^10.70.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^12.0.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.378.0",
    "mammoth": "^1.12.0",
    "node-trello": "^1.3.0",
    "node-webcam": "^0.8.2",
    "officeparser": "^6.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "react-textarea-autosize": "^8.5.9",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@_davideast/stitch-mcp": "^0.5.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^5.3.4"
  }
}
