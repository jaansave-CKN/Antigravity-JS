{
  "name": "antigravity",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --delay 2000",
    "dev:frontend": "vite",
    "dev:backend": "node --watch --env-file=.env server.js",
    "dev:open": "vite --open",
    "build": "vite build",
    "start": "node server.js",
    "render-build": "npm install && npm run build",
    "orchestrate": "node orchestrator.js",
    "start:all": "node 000-orquestador.js",
    "test:smoke": "node backend/scripts/smokeTest.js",
    "test:security": "node backend/scripts/securityValidation.js",
    "test:security:prod": "node backend/scripts/securityValidation.js $PRODUCTION_URL",
    "test:rls": "psql $DATABASE_URL -f backend/scripts/rlsAuditTest.sql",
    "migrate:security": "psql $DATABASE_URL -f backend/migrations/008_trial_sessions_ttl_trigger.sql && psql $DATABASE_URL -f backend/migrations/009_project_version_hashes.sql && psql $DATABASE_URL -f backend/migrations/010_rls_complete_audit.sql",
    "test:all": "npm run test:smoke && npm run test:security",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@google/genai": "^2.15.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.49.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.40.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.2.0",
    "inngest": "^3.29.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "otplib": "^12.0.1",
    "p-limit": "^7.3.1",
    "path": "^0.12.7",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.0",
    "react-textarea-autosize": "^8.5.9",
    "resend": "^4.5.1",
    "sql.js": "^1.14.1",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "url": "^0.11.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "pm2": "^7.0.1",
    "typescript": "^5.8.2",
    "vite": "^8.0.14"
  }
}
